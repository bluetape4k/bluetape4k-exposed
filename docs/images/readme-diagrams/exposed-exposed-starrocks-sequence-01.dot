digraph starrocks_sequence {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    nodesep=0.65,
    ranksep=0.9,
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Architects Daughter",
    fontsize=17,
    margin="0.18,0.12",
    penwidth=1.8
  ];
  edge [
    fontname="Comic Mono",
    fontsize=11,
    penwidth=1.8,
    arrowsize=0.8,
    color="#6f7d90"
  ];

  code [label="Kotlin Code", fillcolor="#E8F3FF", color="#5B8DEF"];
  db [label="StarRocksDatabase", fillcolor="#FDECEF", color="#DC6B82"];
  exposed [label="Exposed Transaction", fillcolor="#EAF7EF", color="#58A978"];
  wrapper [label="ConnectionWrapper", fillcolor="#F7F1E7", color="#B88A44"];
  driver [label="Connector/J", fillcolor="#E8F3FF", color="#5B8DEF"];
  starrocks [label="StarRocks FE/BE", fillcolor="#E9F7F6", color="#45A7A1"];

  code -> db [label="connect(host, catalog, db)"];
  db -> driver [label="DriverManager.getConnection"];
  db -> wrapper [label="force autocommit"];
  code -> exposed [label="transaction(db)"];
  exposed -> wrapper [label="execute SQL"];
  wrapper -> driver [label="prepare/execute"];
  driver -> starrocks [label="JDBC query"];
  starrocks -> driver [label="ResultSet"];
  driver -> exposed [label="rows"];
  code -> db [label="metadata smoke"];
  db -> starrocks [label="DatabaseMetaData"];
}
