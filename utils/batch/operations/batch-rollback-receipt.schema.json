{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluetape4k.dev/schemas/batch-rollback-receipt.schema.json",
  "title": "Bluetape4k batch rollback receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "application", "environment", "releaseHead",
    "releaseOwner", "rollbackTargetHead", "approval", "schedulingStoppedAt",
    "activeLeaseInventory", "writerReconciliation", "drainStartedAt",
    "drainedAt", "resultAt", "simultaneousWriterCount", "result"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "application": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "releaseHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "releaseOwner": {"type": "string", "minLength": 1},
    "rollbackTargetHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approval": {"$ref": "#/$defs/artifact"},
    "schedulingStoppedAt": {"type": "string", "format": "date-time"},
    "activeLeaseInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "lastActiveLeaseAt"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lastActiveLeaseAt": {"type": "string", "format": "date-time"}
      }
    },
    "writerReconciliation": {"$ref": "#/$defs/artifact"},
    "drainStartedAt": {"type": "string", "format": "date-time"},
    "drainedAt": {"type": "string", "format": "date-time"},
    "resultAt": {"type": "string", "format": "date-time"},
    "simultaneousWriterCount": {"type": "integer", "minimum": 0},
    "result": {"const": "ready"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
