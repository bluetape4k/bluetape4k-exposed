{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluetape4k.dev/schemas/batch-alerts.schema.json",
  "title": "Bluetape4k batch lease alert catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "alerts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "alerts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/alert"}
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "operator", "threshold"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "enum": [">", ">=", "<", "<=", "=="]},
        "threshold": {"oneOf": [{"type": "number"}, {"type": "string", "minLength": 1}]},
        "denominator": {"type": "string", "minLength": 1},
        "includesTimeoutSamples": {"type": "boolean"},
        "window": {"type": "string", "pattern": "^[1-9][0-9]*m$"}
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "severity", "owner", "route", "window", "minimumSamples",
        "condition", "action", "clearCondition", "resumeAuthority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "batch-lease-loss-critical",
            "batch-renewal-failure-high",
            "batch-renewal-latency-high",
            "batch-cancellation-completion-failed-critical"
          ]
        },
        "severity": {"type": "string", "enum": ["critical", "high"]},
        "owner": {"const": "batch-platform"},
        "route": {"const": "batch-oncall"},
        "window": {"type": "string", "pattern": "^[1-9][0-9]*m$"},
        "minimumSamples": {"type": "integer", "minimum": 1},
        "condition": {"$ref": "#/$defs/condition"},
        "action": {"type": "string", "minLength": 1},
        "clearCondition": {"$ref": "#/$defs/condition"},
        "resumeAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "role", "requiredEvidence"],
          "properties": {
            "authority": {"const": "release-owner"},
            "role": {"const": "release-owner"},
            "requiredEvidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "enum": ["operator", "db-health", "capacity", "reconciliation"]}
            }
          }
        }
      }
    }
  }
}
