{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluetape4k.dev/schemas/batch-rollback-approval.schema.json",
  "title": "Bluetape4k batch rollback approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "application", "environment", "releaseHead",
    "rollbackTargetHead", "approver", "protectedAuthority", "approvedAt",
    "expiresAt", "protectedApproval"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "application": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "releaseHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rollbackTargetHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approver": {"type": "string", "minLength": 1},
    "protectedAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "role"],
      "properties": {
        "authority": {"const": "release-owner"},
        "role": {"const": "release-owner"}
      }
    },
    "approvedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "protectedApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storeReference", "signature", "checksum"],
      "properties": {
        "storeReference": {"$ref": "#/$defs/restrictedReference"},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "restrictedReference": {
      "type": "string",
      "pattern": "^restricted://[^/?#[:space:]]+/.+$"
    }
  }
}
