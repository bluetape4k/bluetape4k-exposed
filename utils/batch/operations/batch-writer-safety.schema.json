{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluetape4k.dev/schemas/batch-writer-safety.schema.json",
  "title": "Bluetape4k batch writer safety receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "application", "releaseHead", "releaseOwner", "generatedAt", "writers"],
  "properties": {
    "schemaVersion": {"const": 1},
    "application": {"type": "string", "minLength": 1},
    "releaseHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "releaseOwner": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "writers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/writer"}
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "pattern": "^restricted://[^/?#[:space:]]+/.+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sideEffect", "recoveryReceipt", "reviewedAt"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sideEffect": {"type": "string", "minLength": 1},
        "idempotencyKey": {"$ref": "#/$defs/reference"},
        "remoteFencing": {"$ref": "#/$defs/reference"},
        "transactionalOutbox": {"$ref": "#/$defs/reference"},
        "recoveryReceipt": {"$ref": "#/$defs/reference"},
        "reviewedAt": {"type": "string", "format": "date-time"}
      },
      "anyOf": [
        {"required": ["idempotencyKey"]},
        {"required": ["remoteFencing"]},
        {"required": ["transactionalOutbox"]}
      ]
    }
  }
}
